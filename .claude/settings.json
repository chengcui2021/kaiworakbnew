{
  "extraKnownMarketplaces": {
    "metamorphic": {
      "source": {
        "source": "github",
        "repo": "Luminar-Consulting-Org/metamorphic-claude-conventions"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "frontend-standards@metamorphic": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-plugin.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(sudo rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker rm:*)",
      "Bash(docker container rm:*)",
      "Bash(docker compose down:*)",
      "Bash(docker-compose down:*)",
      "Bash(dropdb:*)",
      "Bash(redis-cli flushall:*)",
      "Bash(redis-cli flushdb:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod -R 777:*)"
    ]
  }
}
