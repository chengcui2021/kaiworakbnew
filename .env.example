# Runtime environment for the KB prototype deployment.
PYTHONUNBUFFERED=1
VITE_PROXY_TARGET=http://backend:8000
VITE_API_BASE_URL=

# Customer-node privacy: resolve knowledge with local embeddings by default.
# Use a 1024-dimensional OpenAI-compatible embedding model (for example BGE-M3
# behind an OpenAI-compatible local gateway). Set EMBEDDING_PROVIDER=bedrock only
# for the internal/hosted deployment when desired.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_TIMEOUT_SECONDS=60

# Same KB service code runs internally and on customer Mac mini nodes.
# Internal keeps the full intelligence/admin UI for Knowledge Sources, review,
# shared baseline curation and internal evidence learning. Customer nodes keep
# their own persistent private data and learning locally.
KAIWORA_NODE_ROLE=internal
KAIWORA_FULL_ADMIN_UI=true
KAIWORA_KNOWLEDGE_SOURCES_ENABLED=true
KAIWORA_LOCAL_LEARNING_ENABLED=true
KAIWORA_SHARED_BASELINE_ENABLED=true
